#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp N5  &kp NUMBER_6       &kp N7    &kp N8          &kp N9     &kp N0         &kp MINUS         &kp EQUAL          &kp BACKSPACE                &kp GRAVE
&kp TAB           &kp Q         &kp W         &kp E         &kp R          &kp T   &kp Y              &kp U     &kp I           &kp O      &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp PAGE_UP
&kp CAPSLOCK      &kp A         &kp S         &kp D         &kp F          &kp G   &kp H              &kp J     &kp K           &kp L      &kp SEMICOLON  &kp SQT           &kp ENTER          &kp PAGE_DOWN
&kp LEFT_SHIFT                  &kp Z         &kp X         &kp C          &kp V   &kp B              &kp N     &kp M           &kp COMMA  &kp PERIOD     &kp SLASH         &kp RIGHT_SHIFT                   &kp UP_ARROW  &kp DEL
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE     &kp RIGHT_ALT  &mo 1   &kp RIGHT_CONTROL  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
